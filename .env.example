# ==============================================================================
# OPTION 1: Google AI Studio (Default)
# ==============================================================================
# GEMINI_API_KEY: Required for Gemini API calls via AI Studio.
# Obtain from https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ==============================================================================
# OPTION 2: Google Cloud - Gemini Enterprise Agent Platform (formerly Vertex AI)
# ==============================================================================
# To use your existing Google Cloud project:
# Set GOOGLE_GENAI_USE_ENTERPRISE=true (or GOOGLE_GENAI_USE_VERTEXAI=true)
#
# Path A: Using an Express Mode API Key
# Create an API Key in GCP Console (APIs & Services > Credentials), enable Vertex AI API.
# GOOGLE_GENAI_USE_ENTERPRISE="true"
# GEMINI_API_KEY="AIzaSy..." # Your Vertex-enabled API key
#
# Path B: Keyless IAM / Service Account (Recommended on Cloud Run / GKE)
# Grant roles/aiplatform.user to your Cloud Run service account, or run `gcloud auth application-default login` locally.
# GOOGLE_GENAI_USE_ENTERPRISE="true"
# GOOGLE_CLOUD_PROJECT="my-gcp-project-id"
# GOOGLE_CLOUD_LOCATION="us-central1"

# ==============================================================================
# App Hosting
# ==============================================================================
# APP_URL: The URL where this applet is hosted (e.g. Cloud Run service URL).
APP_URL="MY_APP_URL"

