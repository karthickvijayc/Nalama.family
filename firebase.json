{
  "hosting": {
    "site": "nalama",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "run": {
          "serviceId": "nalama-family",
          "region": "asia-southeast1"
        }
      }
    ]
  }
}
